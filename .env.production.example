# GESTISAC production template.
# Copy values into the hosting provider environment settings. Do not commit real secrets.

GESTISAC_ENV=production

# API runtime. Vercel serverless ignores host/port; container platforms use them.
GESTISAC_API_HOST=0.0.0.0
GESTISAC_API_PORT=3000

# Public web origins allowed to call the API.
GESTISAC_CORS_ORIGINS=https://gestisac.example.com,https://hq.gestisac.example.com,https://client.gestisac.example.com,https://worker.gestisac.example.com

# Supabase Postgres connection string. Prefer the session pooler on port 5432 for SQLx.
GESTISAC_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Optional. Keep false in normal production deploys.
GESTISAC_RUN_MIGRATIONS=false
GESTISAC_SYNC_ON_STARTUP=false

# Generate a strong random value in the hosting provider secret manager.
JWT_SECRET=<strong-random-secret>

# Keep demo seed disabled in production.
GESTISAC_ALLOW_DEMO_SEED=false

# Production on Vercel should use Postgres-backed file_objects; container platforms may use filesystem only with a persistent volume.
GESTISAC_DOCUMENT_STORAGE_BACKEND=postgres
GESTISAC_DOCUMENT_STORAGE_PATH=/var/lib/gestisac/documents

# Web apps.
VITE_API_BASE_URL=https://api.gestisac.example.com
