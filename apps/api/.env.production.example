# API production template.
# Configure these in Vercel/Render/Railway/Cloud Run environment settings.

GESTISAC_ENV=production
GESTISAC_API_HOST=0.0.0.0
GESTISAC_API_PORT=3000
GESTISAC_CORS_ORIGINS=https://gestisac.example.com,https://hq.gestisac.example.com,https://client.gestisac.example.com,https://worker.gestisac.example.com
# Prefer the Supabase session pooler on port 5432 for SQLx.
GESTISAC_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# Optional: set to true only for a one-off migration rollout.
GESTISAC_RUN_MIGRATIONS=false
# Optional: keep false in serverless production to avoid cold-start write races.
GESTISAC_SYNC_ON_STARTUP=false
JWT_SECRET=<strong-random-secret>
GESTISAC_ALLOW_DEMO_SEED=false
# Vercel/serverless production should use postgres. Filesystem is only safe with a persistent volume.
GESTISAC_DOCUMENT_STORAGE_BACKEND=postgres
GESTISAC_DOCUMENT_STORAGE_PATH=/var/lib/gestisac/documents
