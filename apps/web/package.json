{
  "name": "@gestisac/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build && vite build -c adapters/static/vite.config.ts",
    "build:dev-login": "vite build --mode development && vite build -c adapters/static/vite.config.ts --mode development && vite build --ssr src/entry.preview.tsx --outDir server --mode development",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-qwik": "^1.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.5",
    "vite": "^6.4.2",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.1.9"
  }
}
