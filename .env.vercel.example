# GESTISAC Vercel environment template.
# Copy the values to the correct Vercel project environment settings.
# Do not commit real secrets in .env files.
#
# Projects:
# - API: gestisac-api / apps/api
# - Web: gestisac-web / apps/web

###############################################################################
# Vercel project: gestisac-api
# Environment: Production
###############################################################################

GESTISAC_ENV=production

# Public web origins allowed to call the API.
GESTISAC_CORS_ORIGINS=https://gestisac-web.vercel.app

# Supabase/Postgres connection string.
# Prefer Supabase session pooler port 5432 for SQLx.
GESTISAC_DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<region>.pooler.supabase.com:5432/postgres

# Strong random secret, at least 32 characters.
JWT_SECRET=<strong-random-secret>

# Browser-session/smoke user. The email defaults to admin@gestisac.pt if unset.
GESTISAC_SMOKE_EMAIL=admin@gestisac.pt
GESTISAC_SMOKE_PASSWORD=<production-smoke-user-password>

# Keep these disabled in normal production deploys.
GESTISAC_ALLOW_DEMO_SEED=false
GESTISAC_RUN_MIGRATIONS=false
GESTISAC_SYNC_ON_STARTUP=false

# Vercel/serverless production should use Postgres-backed document storage.
GESTISAC_DOCUMENT_STORAGE_BACKEND=postgres

# Optional on Vercel when document storage backend is postgres.
# Only needed for filesystem/container deploys with persistent storage.
# GESTISAC_DOCUMENT_STORAGE_PATH=/var/lib/gestisac/documents

# Optional: used by /api/auth/browser-session redirects.
# If unset, the API defaults to https://gestisac-web.vercel.app.
GESTISAC_WEB_URL=https://gestisac-web.vercel.app

# Optional: Vercel/serverless ignores host/port, but other runtimes use them.
# GESTISAC_API_HOST=0.0.0.0
# GESTISAC_API_PORT=3000

###############################################################################
# Vercel project: gestisac-web
# Environment: Production
###############################################################################

VITE_API_BASE_URL=https://gestisac-api.vercel.app

###############################################################################
# Local-only helpers for deploy/readiness scripts
# Do not add these to the Vercel project env unless you explicitly need them.
###############################################################################

# Used by scripts/check-production-api.mjs and scripts/check-production-readiness.mjs.
GESTISAC_API_URL=https://gestisac-api.vercel.app
GESTISAC_WEB_URL=https://gestisac-web.vercel.app
GESTISAC_LOGIN_NEEDED=false

# Optional readiness budgets.
# GESTISAC_READY_WARMUP_MAX_MS=5000
# GESTISAC_READY_LOGINLESS_MAX_MS=5000

# Optional old-demo credential rejection check.
# GESTISAC_OLD_DEMO_EMAIL=admin@gestisac.pt
# GESTISAC_OLD_DEMO_PASSWORD=<old-demo-password-that-must-be-rejected>

# Optional local Vercel CLI deploy overrides. Normally read from .vercel/project.json.
# VERCEL_ORG_ID=<vercel-org-id>
# VERCEL_PROJECT_ID=<vercel-project-id>

# Vercel system variables such as VERCEL and VERCEL_ENV are provided by Vercel.
# Do not configure them manually in the project environment.
